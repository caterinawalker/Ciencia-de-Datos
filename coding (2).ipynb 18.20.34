   "source": [
    "# ---------- Punto 9: tabla descriptiva + 2 gráficos ----------\n",
    "# Tabla descriptiva simple\n",
    "desc = respondieron.groupby(\"ano4\")[\"pobre\"].describe()\n",
    "print(\"\\nDescriptivas de 'pobre' por año:\")\n",
    "print(desc)\n",
    "\n",
    "# Gráfico 1: Barras con % de pobres por año\n",
    "plt.figure(figsize=(6,4))\n",
    "sns.barplot(data=pobre_stats, x=\"ano4\", y=\"pct_pobres\")\n",
    "plt.ylabel(\"% de pobres\")\n",
    "plt.xlabel(\"Año\")\n",
    "plt.title(\"Porcentaje de 'pobres' (aprox.) por año\")\n",
    "plt.show()\n",
    "\n",
    "# Gráfico 2: Boxplot de ipcf según condición de pobreza, por año\n",
    "plt.figure(figsize=(8,5))\n",
    "sns.boxplot(data=respondieron, x=\"pobre\", y=\"ipcf\", hue=\"ano4\")\n",
    "plt.xlabel(\"pobre (0=no, 1=sí)\")\n",
    "plt.ylabel(\"ipcf\")\n",
    "plt.title(\"Distribución de ipcf por condición de pobreza y año\")\n",
    "plt.legend(title=\"Año\")\n",
    "plt.yscale(\"log\")  # útil si ipcf es muy asimétrico\n",
    "plt.show()"
   ]
  }
 ],
