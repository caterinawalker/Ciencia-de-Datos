   ],
   "source": [
    "\n",
    "# ---------- Punto 8: variable pobre (con ipcf como proxy de ITF per cápita) ----------\n",
    "# Nota: Como trabajamos con ipcf (ingreso per cápita), estrictamente el corte correcto sería:\n",
    "#  'ipcf' * tamaño_hogar  vs  ingreso_necesario\n",
    "# Si no tenés tamaño_hogar ni ITF, usamos ipcf directamente como aproximación práctica del TP.\n",
    "respondieron[\"pobre\"] = (respondieron[\"ipcf\"] < respondieron[\"ingreso_necesario\"]).astype(int)\n",
    "\n",
    "# Cantidad y porcentaje por año\n",
    "pobre_stats = respondieron.groupby(\"ano4\")[\"pobre\"].agg(n_pobres=\"sum\", pct_pobres=\"mean\").reset_index()\n",
    "pobre_stats[\"pct_pobres\"] = (pobre_stats[\"pct_pobres\"] * 100).round(2)\n",
    "print(\"Pobreza (conteo y % sobre la muestra con ipcf válido):\")\n",
    "print(pobre_stats)"
   ]
  },
