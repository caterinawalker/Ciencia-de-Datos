       "<Figure size 1200x1000 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "vars_corr = [\"ch04\", \"ch06\", \"ch07\", \"ch08\", \"nivel_ed\", \"estado\", \"cat_inac\", \"ipcf\"]\n",
    "rename_dict = {\"ch04\": \"sexo\", \"ch06\": \"anos\", \"ch07\": \"estado_civil\", \"ch08\": \"cob_medica\"}\n",
    "cat_cols = [\"estado_civil\", \"cob_medica\", \"nivel_ed\", \"estado\", \"cat_inac\"]\n",
    "\n",
    "# --- 2005 ---\n",
    "df2005 = (\n",
    "    df_combinado.loc[df_combinado[\"ano4\"] == 2005, vars_corr]\n",
    "    .rename(columns=rename_dict)\n",
    "    .copy()\n",
    ")\n",
    "df2005[\"sexo\"] = df2005[\"sexo\"].map({1: 0, 2: 1})\n",
    "df2005_d = pd.get_dummies(df2005, columns=[c for c in cat_cols if c in df2005.columns], drop_first=True)\n",
    "corr2005 = df2005_d.corr()\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "sns.heatmap(corr2005, cmap=\"coolwarm\", center=0)\n",
    "plt.title(\"Matriz de correlación 2005 (numéricas + dummies)\")\n",
    "plt.show()\n",
    "\n",
    "# --- 2025 ---\n",
    "df2025 = (\n",
    "    df_combinado.loc[df_combinado[\"ano4\"] == 2025, vars_corr]\n",
    "    .rename(columns=rename_dict)\n",
    "    .copy()\n",
    ")\n",
    "df2025[\"sexo\"] = df2025[\"sexo\"].map({1: 0, 2: 1})\n",
    "df2025_d = pd.get_dummies(df2025, columns=[c for c in cat_cols if c in df2025.columns], drop_first=True)\n",
    "\n",
    "# (opcional) alinear columnas entre años para comparar mejor\n",
    "df2005_d, df2025_d = df2005_d.align(df2025_d, join=\"outer\", axis=1, fill_value=0)\n",
    "\n",
    "corr2025 = df2025_d.corr()\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "sns.heatmap(corr2025, cmap=\"coolwarm\", center=0)\n",
    "plt.title(\"Matriz de correlación 2025 (numéricas + dummies)\")\n",
    "plt.show()\n"
   ]
  },
