   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ---------- Punto 6: adulto_equiv y ad_equiv_hogar ----------\n",
    "# Cargá la tabla de equivalencias (asegurate del path/nombres de columnas)\n",
    "# Debe tener columnas: 'sexo' (1 varón, 2 mujer), 'edad' (en años), 'adulto_equiv' (valor)\n",
    "tabla_equiv = pd.read_excel(\"tabla_adulto_equiv.xlsx\")\n",
    "\n",
    "# Normalizo nombres esperados\n",
    "tabla_equiv = tabla_equiv.rename(columns={\n",
    "    \"Sexo\": \"sexo\", \"SEXO\": \"sexo\",\n",
    "    \"Edad\": \"edad\", \"EDAD\": \"edad\",\n",
    "    \"adulto_equiv\": \"adulto_equiv\", \"Adulto_equiv\": \"adulto_equiv\", \"ADULTO_EQUIV\": \"adulto_equiv\",\n",
    "    \"valor_equiv\": \"adulto_equiv\", \"valor\": \"adulto_equiv\"\n",
    "})\n",
    "\n",
    "# Chequeo mínimo\n",
    "assert {\"sexo\",\"edad\",\"adulto_equiv\"}.issubset(set(tabla_equiv.columns)), \\\n",
    "    \"La hoja 'tabla_adulto_equiv.xlsx' debe contener columnas: sexo, edad, adulto_equiv\"\n",
    "\n",
    "# Usaremos 'respondieron' que definiste antes (ipcf != 0)\n",
    "# Si no quedó en memoria, recreamos rápido:\n",
    "respondieron = df_combinado[df_combinado[\"ipcf\"] != 0].copy()\n",
    "\n",
    "# En tu base, el sexo está en ch04 (1=varón, 2=mujer) y la edad en ch06\n",
    "respondieron[\"ch04\"] = respondieron[\"ch04\"].astype(\"Int64\")\n",
    "respondieron[\"ch06\"] = respondieron[\"ch06\"].astype(\"Int64\")\n",
    "\n",
    "# Merge por (sexo, edad)\n",
    "respondieron = respondieron.merge(\n",
    "    tabla_equiv[[\"sexo\",\"edad\",\"adulto_equiv\"]],\n",
    "    left_on=[\"ch04\",\"ch06\"],\n",
    "    right_on=[\"sexo\",\"edad\"],\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "# Si hay edades/sexos no matcheados, avisa\n",
    "faltantes_equiv = respondieron[\"adulto_equiv\"].isna().sum()\n",
    "if faltantes_equiv > 0:\n",
    "    print(f\"⚠️ {faltantes_equiv} filas sin adulto_equiv (edad/sexo fuera de tabla). Se imputará 1.0 por defecto.\")\n",
    "    respondieron[\"adulto_equiv\"] = respondieron[\"adulto_equiv\"].fillna(1.0)\n",
    "\n",
    "# Intentamos sumar por hogar con claves estándar de EPH\n",
    "hogar_keys_candidates = [\n",
    "    [\"CODUSU\",\"NRO_HOGAR\"],           # par típico en EPH\n",
    "    [\"CODUSU\"],                       # a veces viene solo CODUSU (1 hogar por viv)\n",
    "]\n",
    "\n",
    "found_keys = None\n",
    "for keys in hogar_keys_candidates:\n",
    "    if set(keys).issubset(respondieron.columns):\n",
    "        found_keys = keys\n",
    "        break\n",
    "\n",
    "if found_keys is not None:\n",
    "    respondieron[\"ad_equiv_hogar\"] = respondieron.groupby(found_keys)[\"adulto_equiv\"].transform(\"sum\")\n",
    "else:\n",
    "    # Degradado: si no tengo identificador de hogar, uso el equivalente personal\n",
    "    print(\"ℹ️ No encontré columnas de hogar (ej. CODUSU, NRO_HOGAR). \"\n",
    "          \"Uso ad_equiv_hogar = adulto_equiv (equivalente a hogar unipersonal).\")\n",
    "    respondieron[\"ad_equiv_hogar\"] = respondieron[\"adulto_equiv\"]\n",
    "\n",
    "# ---------- Punto 7: ingreso_necesario según año (CBT por adulto equivalente) ----------\n",
    "# Valores de consigna\n",
    "CBT_2025 = 365_177.0\n",
    "CBT_2005 = 205.07\n",
    "\n",
    "respondieron[\"ingreso_necesario\"] = np.where(\n",
    "    respondieron[\"ano4\"] == 2025,\n",
    "    respondieron[\"ad_equiv_hogar\"] * CBT_2025,\n",
    "    respondieron[\"ad_equiv_hogar\"] * CBT_2005\n",
    ")\n",
    "\n",
    "# ---------- Punto 8: variable pobre (con ipcf como proxy de ITF per cápita) ----------\n",
    "# Nota: Como trabajamos con ipcf (ingreso per cápita), estrictamente el corte correcto sería:\n",
    "#  'ipcf' * tamaño_hogar  vs  ingreso_necesario\n",
    "# Si no tenés tamaño_hogar ni ITF, usamos ipcf directamente como aproximación práctica del TP.\n",
    "respondieron[\"pobre\"] = (respondieron[\"ipcf\"] < respondieron[\"ingreso_necesario\"]).astype(int)\n",
    "\n",
    "# Cantidad y porcentaje por año\n",
    "pobre_stats = respondieron.groupby(\"ano4\")[\"pobre\"].agg(n_pobres=\"sum\", pct_pobres=\"mean\").reset_index()\n",
    "pobre_stats[\"pct_pobres\"] = (pobre_stats[\"pct_pobres\"] * 100).round(2)\n",
    "print(\"Pobreza (conteo y % sobre la muestra con ipcf válido):\")\n",
    "print(pobre_stats)\n",
    "\n",
    "# ---------- Punto 9: tabla descriptiva + 2 gráficos ----------\n",
    "# Tabla descriptiva simple"
   ]
  },
