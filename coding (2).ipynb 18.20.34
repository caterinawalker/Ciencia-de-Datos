      "Cell \u001b[0;32mIn[59], line 5\u001b[0m\n\u001b[1;32m      1\u001b[0m \u001b[38;5;66;03m# ---------- Punto 8: variable pobre (con ipcf como proxy de ITF per cápita) ----------\u001b[39;00m\n\u001b[1;32m      2\u001b[0m \u001b[38;5;66;03m# Nota: Como trabajamos con ipcf (ingreso per cápita), estrictamente el corte correcto sería:\u001b[39;00m\n\u001b[1;32m      3\u001b[0m \u001b[38;5;66;03m#  'ipcf' * tamaño_hogar  vs  ingreso_necesario\u001b[39;00m\n\u001b[1;32m      4\u001b[0m \u001b[38;5;66;03m# Si no tenés tamaño_hogar ni ITF, usamos ipcf directamente como aproximación práctica del TP.\u001b[39;00m\n\u001b[0;32m----> 5\u001b[0m respondieron[\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mpobre\u001b[39m\u001b[38;5;124m\"\u001b[39m] \u001b[38;5;241m=\u001b[39m (respondieron[\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mipcf\u001b[39m\u001b[38;5;124m\"\u001b[39m] \u001b[38;5;241m<\u001b[39m respondieron[\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mingreso_necesario\u001b[39m\u001b[38;5;124m\"\u001b[39m])\u001b[38;5;241m.\u001b[39mastype(\u001b[38;5;28mint\u001b[39m)\n\u001b[1;32m      7\u001b[0m \u001b[38;5;66;03m# Cantidad y porcentaje por año\u001b[39;00m\n\u001b[1;32m      8\u001b[0m pobre_stats \u001b[38;5;241m=\u001b[39m respondieron\u001b[38;5;241m.\u001b[39mgroupby(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mano4\u001b[39m\u001b[38;5;124m\"\u001b[39m)[\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mpobre\u001b[39m\u001b[38;5;124m\"\u001b[39m]\u001b[38;5;241m.\u001b[39magg(n_pobres\u001b[38;5;241m=\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124msum\u001b[39m\u001b[38;5;124m\"\u001b[39m, pct_pobres\u001b[38;5;241m=\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mmean\u001b[39m\u001b[38;5;124m\"\u001b[39m)\u001b[38;5;241m.\u001b[39mreset_index()\n",
