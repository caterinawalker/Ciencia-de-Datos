   "source": [
    "# ---------- Punto 7: ingreso_necesario según año (CBT por adulto equivalente) ----------\n",
    "# Valores de consigna\n",
    "CBT_2025 = 365_177.0\n",
    "CBT_2005 = 205.07\n",
    "\n",
    "respondieron[\"ingreso_necesario\"] = np.where(\n",
    "    respondieron[\"ano4\"] == 2025,\n",
    "    respondieron[\"ad_equiv_hogar\"] * CBT_2025,\n",
    "    respondieron[\"ad_equiv_hogar\"] * CBT_2005\n",
    ")"
   ]
  },
