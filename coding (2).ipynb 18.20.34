   "source": [
    "#Opción A (mínimo cambio): solo correlacionar columnas numéricas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "e94b7757-c162-47ff-b23e-52c2aa0dd70e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
